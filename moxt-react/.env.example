VITE_API_URL=http://localhost:4000/api

# Supabase (clés publiques — anon key conçue pour être exposée côté client)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx

# Capacitor — live reload en dev (IP LAN + port Vite, ex. http://192.168.1.10:5173)
# Option rapide : npm run cap:dev puis npm run cap:dev:sync (depuis moxt-react)
# CAPACITOR_SERVER_URL=http://192.168.1.10:5173

# Web Push (PWA iOS 16.4+, Chrome…) — générer : npm run push:generate-vapid
# Les clés vivent dans scripts/phase2.env ; `npm run web` / `npm run build` injectent
# VITE_VAPID_PUBLIC_KEY via moxt-react/scripts/prepare-netlify-env.mjs
VITE_VAPID_PUBLIC_KEY=

# Deep links natifs (exemples)
# com.moxt.app://transfers/ID
# moxt://app/marketplace

# Moxti (assistant IA REST) — proxy Edge Function `moxti-assistant` (ne mets PAS la clé dans VITE_*)
# Secrets Supabase (côté serveur uniquement) :
#   npx supabase secrets set MOXTI_API_KEY="ta_cle" --linked
#   npx supabase secrets set MOXTI_API_URL="https://…/api/messages/incoming" --linked
#   npx supabase secrets set MOXTI_API_KEY_HEADER="both" --linked   # both | bearer | x-api-key | api-key
#   npx supabase functions deploy moxti-assistant --linked
# VITE_MOXTI_DIRECT=true  # appel navigateur direct (déconseillé : expose la clé / CORS)

# Traduction auto messages P2P : off | admin (défaut) | all
# VITE_MESSAGE_AUTO_TRANSLATE=all
