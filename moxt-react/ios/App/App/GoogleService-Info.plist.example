<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copiez ce fichier vers GoogleService-Info.plist (gitignoré) après création
  de l’app iOS dans Firebase Console (Bundle ID : com.moxt.app).

  Destination :
    moxt-react/ios/App/App/GoogleService-Info.plist

  Puis : npm run setup:push:native
-->
<plist version="1.0">
<dict>
	<key>CLIENT_ID</key>
	<string>REPLACE.apps.googleusercontent.com</string>
	<key>REVERSED_CLIENT_ID</key>
	<string>com.googleusercontent.apps.REPLACE</string>
	<key>API_KEY</key>
	<string>REPLACE_WITH_FIREBASE_IOS_API_KEY</string>
	<key>GCM_SENDER_ID</key>
	<string>000000000000</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>com.moxt.app</string>
	<key>PROJECT_ID</key>
	<string>moxt-placeholder</string>
	<key>STORAGE_BUCKET</key>
	<string>moxt-placeholder.appspot.com</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<true/>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>IS_SIGNIN_ENABLED</key>
	<true/>
	<key>GOOGLE_APP_ID</key>
	<string>1:000000000000:ios:0000000000000000000000</string>
</dict>
</plist>
