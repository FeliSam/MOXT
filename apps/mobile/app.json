{
  "expo": {
    "name": "MOXT",
    "slug": "moxt-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moxt",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "associatedDomains": ["applinks:moxtapp.ru", "applinks:www.moxtapp.ru"]
    },
    "android": {
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "moxtapp.ru" },
            { "scheme": "https", "host": "www.moxtapp.ru" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorisez l'accès pour envoyer des preuves de paiement.",
          "cameraPermission": "Autorisez l'accès pour photographier des preuves de paiement."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#f7f8fa",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0c0c0e"
          }
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "moxt",
          "project": "moxt-mobile"
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cd96c849-1308-4cc2-9979-0dde3831ebcc"
      }
    },
    "owner": "feliciano6"
  }
}
